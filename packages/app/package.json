{
	"name": "@moonfin/app",
	"version": "2.8.2",
	"description": "Jellyfin client for Smart TVs",
	"author": "RadicalMuffinMan",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"pack": "enact pack",
		"pack-p": "enact pack -p",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"lint": "enact lint .",
		"license": "enact license",
		"test": "enact test",
		"test-watch": "enact test --watch"
	},
	"license": "MPL-2.0",
	"private": true,
	"repository": "https://github.com/Moonfin-Client",
	"overrides": {
		"fsevents": "$fsevents"
	},
	"enact": {
		"theme": "sandstone",
		"ri": {
			"baseSize": 24
		},
		"locales": [
			"en-US",
			"af",
			"ar",
			"be",
			"bg",
			"bn",
			"ca",
			"cs",
			"cy",
			"da",
			"de",
			"el",
			"en-GB",
			"eo",
			"es",
			"es-419",
			"es-AR",
			"es-DO",
			"es-MX",
			"et",
			"fa",
			"fi",
			"fr",
			"gl",
			"he",
			"hi",
			"hr",
			"hu",
			"id",
			"it",
			"ja",
			"kk",
			"kn",
			"ko",
			"lt",
			"lv",
			"mk",
			"ml",
			"mn",
			"nb",
			"nl",
			"pa",
			"pl",
			"pt",
			"pt-BR",
			"pt-PT",
			"ro",
			"ru",
			"si",
			"sk",
			"sl",
			"sq",
			"sr",
			"sv",
			"sw",
			"ta",
			"te",
			"th",
			"tl",
			"tr",
			"ug",
			"uk",
			"vi",
			"yue",
			"yue-CN",
			"yue-HK",
			"zh",
			"zh-Hant"
		],
		"ilib": true,
		"screenTypes": [
			{
				"name": "fhd",
				"pxPerRem": 24,
				"width": 1920,
				"height": 1080
			},
			{
				"name": "uhd",
				"pxPerRem": 48,
				"width": 3840,
				"height": 2160
			}
		]
	},
	"//jest": "npm workspaces hoists ilib to the repo root, where enact's own jest config doesn't look for it. Any test that reaches $L fails to resolve ilib without this.",
	"jest": {
		"moduleNameMapper": {
			"^ilib[/](.*)$": "<rootDir>/../../node_modules/ilib/$1",
			"^@enact[/]i18n[/]ilib[/](.*)$": "<rootDir>/../../node_modules/ilib/$1"
		}
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "^4.8.0",
		"@enact/i18n": "^4.8.0",
		"@enact/sandstone": "^2.8.0",
		"@enact/spotlight": "^4.8.0",
		"@enact/ui": "^4.8.0",
		"@enact/webos": "^5.4.1",
		"@material-symbols/svg-400": "^0.44.4",
		"hls.js": "^1.7.0",
		"ilib": "^14.19.0",
		"jszip": "^3.10.1",
		"libpgs": "^0.8.1",
		"prop-types": "^15.8.1",
		"qrcode-generator": "^2.0.4",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"baseline-browser-mapping": "^2.9.19",
		"eslint-config-enact-proxy": "^1.0.7"
	},
	"optionalDependencies": {
		"fsevents": "^2.3.2"
	}
}
